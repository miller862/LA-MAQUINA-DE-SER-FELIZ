---
/**
 * PodcastPlayer — dos modos:
 *   - episodeUrl presente → iframe embed de RSS.com
 *   - sin episodeUrl      → mockup "próximamente" con botones placeholder
 *
 * Uso:
 *   <PodcastPlayer episodeUrl={entry.data.podcastEpisodeUrl} compact={false} />
 *
 * compact=true → versión pequeña para PostCard lateral
 * compact=false → versión full para página de entrada
 */

interface Props {
  episodeUrl?: string;
  compact?: boolean;
  title?: string;
}
const { episodeUrl, compact = false, title = 'Episodio' } = Astro.props;
---

{episodeUrl ? (
  <!-- Embed real de RSS.com -->
  <div class:list={['podcast-player', compact && 'podcast-player--compact']}>
    <iframe
      src={episodeUrl}
      height={compact ? 80 : 150}
      width="100%"
      frameborder="0"
      scrolling="no"
      allow="autoplay"
      title={title}
      loading="lazy"
    ></iframe>
  </div>
) : (
  <!-- Mockup placeholder -->
  <div class:list={['podcast-mockup', compact && 'podcast-mockup--compact']}>
    <div class="mockup-inner">
      <div class="mockup-icon">🎙️</div>
      <div class="mockup-text">
        {compact
          ? <span>Episodio próximamente</span>
          : <>
              <p class="mockup-label">Este artículo tendrá un episodio de podcast</p>
              <p class="mockup-sub">Disponible próximamente</p>
            </>
        }
      </div>
      {!compact && (
        <div class="mockup-controls">
          <button class="ctrl-btn ctrl-btn--play" disabled aria-label="Play" title="Próximamente">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5,3 19,12 5,21"/>
            </svg>
          </button>
          <div class="ctrl-scrubber">
            <div class="scrubber-bar">
              <div class="scrubber-fill" style="width: 0%"></div>
            </div>
            <div class="scrubber-times">
              <span>0:00</span><span>--:--</span>
            </div>
          </div>
          <button class="ctrl-btn" disabled aria-label="Velocidad" title="Próximamente">
            1×
          </button>
        </div>
      )}
    </div>
  </div>
)}

<style>
  /* ── Embed real ── */
  .podcast-player { border-radius: var(--radius-md); overflow: hidden; }
  .podcast-player--compact { height: 80px; }

  /* ── Mockup full ── */
  .podcast-mockup {
    background: linear-gradient(135deg, var(--color-bg-surface) 0%, var(--color-podcast-tint) 100%);
    border: 1px dashed var(--color-podcast);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
  }

  .mockup-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mockup-icon { font-size: 2rem; }

  .mockup-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }
  .mockup-sub {
    font-size: 0.78rem;
    color: var(--color-podcast);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Controls mockup */
  .mockup-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .ctrl-btn {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 2px solid var(--color-podcast);
    background: transparent;
    color: var(--color-podcast);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: not-allowed;
    opacity: 0.5;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-body);
    flex-shrink: 0;
  }
  .ctrl-btn--play { width: 48px; height: 48px; }

  .ctrl-scrubber { flex: 1; display: flex; flex-direction: column; gap: 0.35rem; }

  .scrubber-bar {
    height: 4px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .scrubber-fill {
    height: 100%;
    background: var(--color-podcast);
    border-radius: var(--radius-full);
    transition: width var(--transition-normal);
  }
  .scrubber-times {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── Mockup compact (para PostCard) ── */
  .podcast-mockup--compact {
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    height: 100%;
    display: flex;
    align-items: center;
  }
  .podcast-mockup--compact .mockup-inner {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  .podcast-mockup--compact .mockup-icon { font-size: 1.1rem; }
  .podcast-mockup--compact .mockup-text {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }
</style>
