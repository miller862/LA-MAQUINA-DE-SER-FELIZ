---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

// Netlify sirve este 404 para cualquier ruta inexistente (ES o EN).
// Mostramos ES con link a la home EN.
const lang = 'es';
---

<Base lang={lang} title={t(lang, 'notfound.title')} description={t(lang, 'notfound.text')}>
  <section class="notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">{t(lang, 'notfound.title')}</h1>
    <p class="notfound__text">{t(lang, 'notfound.text')}</p>
    <div class="notfound__actions">
      <a class="notfound__btn" href="/">{t(lang, 'notfound.back')}</a>
      <a class="notfound__alt" href="/en">English version →</a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding: 7rem 1rem 5rem;
    max-width: 560px;
    margin: 0 auto;
  }
  .notfound__code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 600;
    margin-bottom: 0.9rem;
  }
  .notfound__text {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .notfound__actions { display: flex; gap: 1.25rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .notfound__btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all var(--transition-fast);
  }
  .notfound__btn:hover { background: var(--color-primary); color: var(--color-bg); }
  .notfound__alt { font-size: 0.85rem; color: var(--color-text-muted); }
</style>
