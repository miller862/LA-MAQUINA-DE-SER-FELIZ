---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import TagMultiSelect from '../../components/TagMultiSelect.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n';
import { isPublished } from '../../content/visibility';

const lang = 'en';

const pensamiento  = await getCollection('pensamiento',      e => e.data.lang === 'en' && isPublished(e));
const datos        = await getCollection('ciencia-de-datos', e => e.data.lang === 'en' && isPublished(e));
const podcast      = await getCollection('podcast',          e => e.data.lang === 'en' && isPublished(e));

const allEntries = [
  ...pensamiento.map(e => ({ ...e, vertical: 'pensamiento'      as const })),
  ...datos.map(e       => ({ ...e, vertical: 'ciencia-de-datos' as const })),
  ...podcast.map(e     => ({ ...e, vertical: 'podcast'          as const })),
].sort((a, b) => b.data.date.localeCompare(a.data.date));

const allTags = [...new Set(allEntries.flatMap(e => e.data.tags))].sort();

const verticals = [
  { key: 'pensamiento', title: 'Thinking',     subtitle: 'Politics · Philosophy · Current affairs',
    desc: 'Some everyday reflections to keep from being indifferent to reality.',
    count: pensamiento.length + podcast.length },
  { key: 'data', title: 'Data Science', subtitle: 'Analysis · Models · Data',
    desc: 'A place to tell ideas through data and share my latest projects.',
    count: datos.length },
];
---

<Base lang={lang}>
  <div class="home" data-home>

    <section class="hero fade-up">
      <p class="hero-eyebrow">{t(lang, 'home.subtitle')}</p>
      <h1 class="hero-name">Manuel Miller</h1>
      <p class="hero-intro">{t(lang, 'home.intro')}</p>
    </section>

    <section class="verticals" aria-label="Areas">
      {verticals.map((v, i) => (
        <button type="button" class={`v-panel v-panel--${v.key} fade-up`} style={`--i:${i + 1};`} data-vertical={v.key} aria-pressed="false">
          <div class="v-panel__icon" aria-hidden="true">
            {v.key === 'pensamiento' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.5 2A7.5 7.5 0 0 0 4 14.5c0 2 1 3.5 1 5v2.5h9V19.5c0-1.5 1-3 1-5A7.5 7.5 0 0 0 9.5 2z"/><path d="M10 22h4"/>
              </svg>
            )}
            {v.key === 'data' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/><path d="M7 14l4-4 4 3 6-7"/>
              </svg>
            )}
          </div>
          <div class="v-panel__text">
            <h2 class="v-panel__title">{v.title}</h2>
            <p class="v-panel__subtitle">{v.subtitle}</p>
            <p class="v-panel__desc">{v.desc}</p>
          </div>
          <div class="v-panel__meta">
            <span class="v-panel__count">{v.count}</span>
            <span class="v-panel__count-label">{v.count === 1 ? 'entry' : 'entries'}</span>
            <span class="v-panel__state">
              <span class="off">View entries →</span>
              <span class="on">Showing this section · clear</span>
            </span>
          </div>
        </button>
      ))}
    </section>

    <div class="toolbar">
      <p class="result-hint" id="result-hint">
        <span data-default>Showing all entries</span>
        <span data-active class="hidden"></span>
      </p>
      <TagMultiSelect tags={allTags} lang={lang} />
    </div>

    <section class="entries-list" id="entries-grid">
      {allEntries.map((entry, i) => (
        <PostCard
          title={entry.data.title} date={entry.data.date} description={entry.data.description}
          tags={entry.data.tags} cover={entry.data.cover}
          href={`/en/${entry.vertical === 'pensamiento' ? 'thinking' : entry.vertical === 'ciencia-de-datos' ? 'data-science' : 'podcast'}/${entry.data.postId}`}
          vertical={entry.vertical} lang={lang}
          index={i}
          podcastEpisodeUrl={entry.data.podcastEpisodeUrl}
        />
      ))}
      <p class="no-entries hidden" id="no-entries">{t(lang, 'home.noEntries')}</p>
    </section>
  </div>
</Base>

<style>
  .home { position: relative; }

  .hero { padding: 4.5rem 0 2.5rem; text-align: center; }
  .hero-eyebrow { font-size: 0.78rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 1rem; font-weight: 600; }
  .hero-name { font-family: var(--font-display); font-size: clamp(3rem, 9vw, 6rem); font-weight: 600; color: var(--color-text); line-height: 1.02; margin-bottom: 1.5rem; letter-spacing: -0.01em; }
  .hero-intro { font-size: 1.15rem; color: var(--color-text-secondary); max-width: 520px; margin: 0 auto; line-height: 1.55; }

  .verticals { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin: 2rem 0 2.5rem; }
  @media (max-width: 820px) { .verticals { grid-template-columns: 1fr; } }

  .v-panel { position: relative; text-align: left; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.75rem 1.85rem 1.5rem; cursor: pointer; font-family: var(--font-body); color: inherit; overflow: hidden; transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal), background var(--transition-normal); box-shadow: var(--shadow-card); display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1.25rem; row-gap: 1.1rem; }
  .v-panel::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; transition: width var(--transition-normal); }
  .v-panel--pensamiento::before { background: var(--color-pensamiento); }
  .v-panel--data::before        { background: var(--color-data); }
  .v-panel:hover { transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
  .v-panel--pensamiento:hover { border-color: var(--color-pensamiento); }
  .v-panel--data:hover        { border-color: var(--color-data); }
  .v-panel:hover::before { width: 5px; }
  .v-panel--pensamiento[aria-pressed="true"] { background: var(--color-pensamiento-tint); border-color: var(--color-pensamiento); }
  .v-panel--data[aria-pressed="true"]        { background: var(--color-data-tint); border-color: var(--color-data); }
  .v-panel[aria-pressed="true"]::before { width: 5px; }

  .v-panel__icon { grid-row: 1 / span 2; width: 64px; height: 64px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; transition: transform var(--transition-normal), background var(--transition-normal); flex-shrink: 0; }
  .v-panel--pensamiento .v-panel__icon { background: var(--color-pensamiento-tint); color: var(--color-pensamiento); }
  .v-panel--data .v-panel__icon        { background: var(--color-data-tint);        color: var(--color-data); }
  .v-panel:hover .v-panel__icon { transform: scale(1.06) rotate(-3deg); }

  .v-panel__text { grid-column: 2; }
  .v-panel__title { font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1.05; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .v-panel__subtitle { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .v-panel__desc { font-size: 0.95rem; line-height: 1.55; color: var(--color-text-secondary); }

  .v-panel__meta { grid-column: 2; display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; padding-top: 0.25rem; border-top: 1px solid var(--color-border); margin-top: 0.25rem; }
  .v-panel__count { font-family: var(--font-mono); font-size: 1.6rem; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
  .v-panel--pensamiento .v-panel__count { color: var(--color-pensamiento); }
  .v-panel--data        .v-panel__count { color: var(--color-data); }
  .v-panel__count-label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-muted); }
  .v-panel__state { margin-left: auto; font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); }
  .v-panel__state .on { display: none; }
  .v-panel[aria-pressed="true"] .v-panel__state .off { display: none; }
  .v-panel[aria-pressed="true"] .v-panel__state .on  { display: inline; }

  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 1rem 0 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); position: relative; z-index: 50; }
  .result-hint { font-size: 0.88rem; color: var(--color-text-secondary); font-style: italic; }
  .result-hint .hidden { display: none; }

  .entries-list { display: flex; flex-direction: column; gap: 1.75rem; padding-bottom: 5rem; position: relative; z-index: 1; }
  .entries-list :global(article) {
    transition: opacity var(--transition-normal), transform var(--transition-normal), max-height var(--transition-slow), margin var(--transition-normal);
    max-height: 600px;
    overflow: hidden;
  }
  .entries-list :global(article.is-hidden) {
    opacity: 0;
    transform: translateY(-12px) scale(0.97);
    max-height: 0;
    margin-top: -1.75rem;
    pointer-events: none;
  }
  .entries-list :global(article.is-entering) { animation: cardEnter 0.55s cubic-bezier(.4,0,.2,1) both; }
  @keyframes cardEnter {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1); }
  }
  .no-entries { text-align: center; color: var(--color-text-muted); padding: 3rem 0; }
  .hidden { display: none !important; }
</style>

<script>
  const homeEl = document.querySelector<HTMLElement>('[data-home]');
  const panels = document.querySelectorAll<HTMLButtonElement>('.v-panel');
  const cards  = document.querySelectorAll<HTMLElement>('.entries-list article');
  const noEntries = document.getElementById('no-entries');
  const hint = document.getElementById('result-hint');
  const hintDef = hint?.querySelector<HTMLElement>('[data-default]');
  const hintAct = hint?.querySelector<HTMLElement>('[data-active]');

  let activeVertical: string | null = null;
  let activeTagKeys: string[] = [];

  function refresh() {
    if (homeEl) {
      if (activeVertical) homeEl.dataset.active = activeVertical;
      else delete homeEl.dataset.active;
    }
    panels.forEach(p => p.setAttribute('aria-pressed', p.dataset.vertical === activeVertical ? 'true' : 'false'));

    let visible = 0;
    cards.forEach(card => {
      const v = card.dataset.vertical ?? '';
      const ks = (card.dataset.tagKeys ?? '').split(',');
      const passVertical = !activeVertical || v === activeVertical
        || (activeVertical === 'pensamiento' && v === 'podcast');
      const passTags = activeTagKeys.length === 0 || activeTagKeys.some(k => ks.includes(k));
      const show = passVertical && passTags;
      const wasHidden = card.classList.contains('is-hidden');
      if (show) {
        card.classList.remove('is-hidden');
        if (wasHidden) {
          card.classList.add('is-entering');
          setTimeout(() => card.classList.remove('is-entering'), 600);
        }
        visible++;
      } else {
        card.classList.add('is-hidden');
      }
    });
    if (noEntries) noEntries.classList.toggle('hidden', visible > 0);

    if (hintDef && hintAct) {
      const parts: string[] = [];
      if (activeVertical) parts.push(activeVertical === 'pensamiento' ? 'Thinking (incl. podcast)' : 'Data Science');
      if (activeTagKeys.length) parts.push(`${activeTagKeys.length} tag(s)`);
      if (parts.length === 0) {
        hintDef.classList.remove('hidden'); hintAct.classList.add('hidden');
      } else {
        hintDef.classList.add('hidden'); hintAct.classList.remove('hidden');
        hintAct.textContent = `Showing ${visible} ${visible === 1 ? 'entry' : 'entries'} in ${parts.join(' · ')}`;
      }
    }
  }

  panels.forEach(p => p.addEventListener('click', () => {
    const v = p.dataset.vertical!;
    activeVertical = activeVertical === v ? null : v;
    refresh();
  }));

  window.addEventListener('tag-filter-change', (ev) => {
    activeTagKeys = (ev as CustomEvent).detail.tagKeys || [];
    refresh();
  });

  function applyHash() {
    const m = location.hash.match(/v=(pensamiento|data)/);
    if (m) { activeVertical = m[1]; refresh(); }
  }
  applyHash();
  window.addEventListener('hashchange', applyHash);
</script>
