---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';
---

<Base lang="en" title={t('en', 'about.title')}>
  <div class="about-page">
    <div class="about-avatar">
      <div class="avatar-placeholder">MM</div>
    </div>
    <div class="about-content">
      <h1>{t('en', 'about.title')}</h1>
      <p class="about-subtitle">Political Scientist · Data Scientist · Buenos Aires</p>
      <div class="about-body prose">
        <p>
          I started studying politics because I wanted to understand why things are the way they are.
          I ended up learning to code because data felt like the most honest tool for asking that question.
        </p>
        <p>
          I work at the intersection of social science and data analysis: elections, public opinion,
          political communication. On this site I write about what obsesses me, what confuses me,
          and what I'm learning.
        </p>
        <p>If something resonates, let's talk.</p>
      </div>
      <a href="https://www.linkedin.com/in/manuel-miller/" target="_blank" rel="noopener noreferrer" class="linkedin-btn">
        LinkedIn →
      </a>
    </div>
  </div>
</Base>

<style>
  .about-page { display: grid; grid-template-columns: auto 1fr; gap: 3rem; padding: 4rem 0; align-items: start; max-width: 720px; }
  .avatar-placeholder { width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; color: white; font-family: var(--font-display); flex-shrink: 0; }
  .about-content { display: flex; flex-direction: column; gap: 1rem; }
  h1 { font-size: 2rem; }
  .about-subtitle { font-size: 0.875rem; color: var(--color-primary-light); letter-spacing: 0.05em; }
  .about-body p { color: var(--color-text-secondary); margin-bottom: 1rem; }
  .linkedin-btn { display: inline-block; margin-top: 0.5rem; padding: 0.5rem 1.25rem; background: var(--color-primary); color: white; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; transition: background var(--transition-fast); }
  .linkedin-btn:hover { background: var(--color-primary-dark); color: white; }
  @media (max-width: 600px) { .about-page { grid-template-columns: 1fr; } }
</style>
