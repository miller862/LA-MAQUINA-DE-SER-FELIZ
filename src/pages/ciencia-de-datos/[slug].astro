---
import Base from '../../layouts/Base.astro';
import PodcastPlayer from '../../components/PodcastPlayer.astro';
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../content/visibility';

export async function getStaticPaths() {
  const entries = await getCollection('ciencia-de-datos', e => e.data.lang === 'es' && isPublished(e));
  return entries.map(e => ({ params: { slug: e.data.postId }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base lang="es" title={entry.data.title} description={entry.data.description}>
  <article class="post-layout">
    <header class="post-header">
      <p class="post-date">{entry.data.date}</p>
      <h1>{entry.data.title}</h1>
      <p class="post-desc">{entry.data.description}</p>
      <ul class="post-tags">
        {entry.data.tags.map((tag: string) => <li>#{tag}</li>)}
      </ul>
    </header>

    {entry.data.podcastEpisodeUrl !== undefined && (
      <div class="post-player">
        <PodcastPlayer episodeUrl={entry.data.podcastEpisodeUrl} compact={false} title={entry.data.title} />
      </div>
    )}

    <div class="post-content prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-layout { max-width: 720px; margin: 3rem auto; padding: 0 1rem; }
  .post-header { margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem; }
  .post-date { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  .post-header h1 { font-size: 2.25rem; margin-bottom: 0.75rem; font-family: var(--font-display); }
  .post-desc { color: var(--color-text-secondary); font-size: 1.05rem; margin-bottom: 1rem; }
  .post-tags { list-style: none; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .post-tags li { font-size: 0.75rem; color: var(--color-text-muted); background: var(--color-bg-surface); padding: 0.2rem 0.6rem; border-radius: var(--radius-full); border: 1px solid var(--color-border); }
  .post-player { margin-bottom: 2rem; }
  .post-content { color: var(--color-text-secondary); }
</style>
